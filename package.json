{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloudflare": "pnpm build && wrangler dev --local --port 8787",
    "dev:cloudflare:qa": "pnpm build:localqa && wrangler dev --local --port 8787 --var LOCAL_DEV_ADMIN:true",
    "build": "vite build",
    "build:localqa": "vite build --mode localqa",
    "preview": "vite preview",
    "test:bundle": "vite build && node scripts/check-bundle-size.mjs",
    "test:vocabulary": "node scripts/validate-vocabulary.mjs",
    "test:imagery": "node scripts/validate-imagery.mjs",
    "test:assessment-audio": "node scripts/validate-assessment-audio.mjs",
    "test:assessment": "tsx scripts/validate-assessment-bank.ts",
    "export:canonical-words": "node scripts/export-canonical-words.mjs",
    "db:migrate:local": "wrangler d1 migrations apply emad-wordlink-submissions --local",
    "db:migrate:remote": "wrangler d1 migrations apply emad-wordlink-submissions --remote",
    "db:canonical:local": "pnpm export:canonical-words && wrangler d1 execute emad-wordlink-submissions --local --file .tmp-canonical-words.sql",
    "db:canonical:remote": "pnpm export:canonical-words && wrangler d1 execute emad-wordlink-submissions --remote --file .tmp-canonical-words.sql",
    "admin:configure": "node scripts/configure-admin-auth.mjs",
    "admin:codes": "node scripts/configure-admin-access-codes.mjs",
    "check:cloudflare": "node scripts/check-cloudflare-config.mjs",
    "deploy:cloudflare": "pnpm check:cloudflare && pnpm build && wrangler deploy",
    "test:submissions": "node --test worker/index.test.js",
    "format": "oxfmt"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "lucide-react": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "wrangler": "^4.151.0"
  }
}
