{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emad-picture-dictionary",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/review-submissions"]
  },
  "vars": {
    "ADMIN_EMAILS": "farhangfaxr3@gmail.com,em20323115@soran.edu.iq",
    "TURNSTILE_HOSTNAMES": "emad-picture-dictionary.farhangfaxr3.workers.dev"
  },
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "SUBMISSIONS_DB",
      "database_name": "emad-wordlink-submissions",
      "database_id": "68f3fee6-36ef-4701-8ee4-c8fe2ce9198c",
      "migrations_dir": "migrations"
    }
  ]
}
